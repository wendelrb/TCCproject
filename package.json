{
  "name": "tcc-diesel-saas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint",
    "start": "next start",
    "demo:dados": "node scripts/preparar-demo.ts",
    "demo": "node scripts/preparar-demo.ts && next dev",
    "demo:estatica": "node scripts/exportar-demo.ts demo.json && node scripts/gerar-estatica.ts demo.json demo-diesel.html",
    "test": "node --test tests/*.test.ts",
    "test:rls": "node --test tests/rls.test.ts",
    "typecheck": "tsc --noEmit",
    "check:deno": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.0",
    "next": "^15.5.23",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "deno": "^2.9.5",
    "typescript": "^5.9.2"
  }
}
